{
	"name": "getkirby/actions-test",
	"description": "The project that CI runs the actions on",
	"license": "MIT",
	"type": "project",
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
		"psr/clock": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Kirby\\Actions\\": "src/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"analyze": [
			"@analyze:composer",
			"@analyze:psalm"
		],
		"analyze:composer": [
			"composer validate --strict --no-check-version --no-check-all",
			"cpx icanhazstring/composer-unused:0.9.7 --no-progress"
		],
		"analyze:psalm": "cpx vimeo/psalm:6.20.4",
		"fix": "cpx getkirby/php-cs:0.2.1 fix",
		"test": "cpx phpunit/phpunit:12.5.42"
	}
}
