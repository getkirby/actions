#!/usr/bin/env php
<?php

use Composer\Semver\Comparator;
use Kirby\Actions\Php;
use Kirby\Actions\Tool;

// the package's own vendor dir when run through cpx or from a clone,
// the host project's when required as a dependency
foreach ([
	dirname(__DIR__) . '/vendor/autoload.php',
	dirname(__DIR__, 3) . '/autoload.php'
] as $autoloader) {
	if (is_file($autoloader) === true) {
		require_once $autoloader;
		break;
	}
}

const USAGE = <<<'TXT'
	Usage: kirby-actions outdated [--update] [--major] [--min-age <days>]

	Lists the tools that the composer scripts run through cpx and their newer
	releases on Packagist, which still run on every PHP version of the project
	that the pinned release runs on.

	  --update          raises each tool to its newest release of the same major
	  --major           with --update, to its newest release, also of a new major
	  --min-age <days>  only releases that are at least this many days old

	TXT;

function fail(string $message): never
{
	fwrite(STDERR, $message . "\n");
	exit(1);
}

$args    = array_slice($argv, 1);
$command = array_shift($args);
$options = ['--update' => false, '--major' => false, '--min-age' => 0];

while (($arg = array_shift($args)) !== null) {
	if ($arg === '--min-age') {
		$days = array_shift($args) ?? '';
		ctype_digit($days) === true || fail('--min-age needs a number of days');
		$options['--min-age'] = (int)$days;
		continue;
	}

	is_bool($options[$arg] ?? null) === true || fail("Unknown option {$arg}\n\n" . USAGE);
	$options[$arg] = true;
}

if ($command !== 'outdated') {
	fail(USAGE);
}

if (is_file('composer.json') === false) {
	fail('There is no composer.json in ' . getcwd());
}

$json     = file_get_contents('composer.json');
$composer = json_decode($json, true, flags: JSON_THROW_ON_ERROR);
$versions = (new Php($composer['require']['php'] ?? '*'))->versions();
$tools    = Tool::load($composer);

if ($tools === []) {
	fail('The composer scripts run no tools through cpx with a version, e.g. "cpx vendor/name:1.2.3"');
}

$updated = $json;
$failed  = false;

foreach ($tools as $tool) {
	$sorted  = $tool->versions();
	$targets = [];
	usort($sorted, fn ($a, $b) => Comparator::compare($a, '<', $b) ? -1 : 1);

	try {
		$tool->releases();
	} catch (RuntimeException $e) {
		printf("%-32s %-10s %s\n", $tool->package, $tool->pin, $e->getMessage());
		$failed = true;
		continue;
	}

	foreach ($sorted as $i => $version) {
		$label = $i === 0 ? $tool->package : '';

		if (preg_match('/^v?\d+(\.\d+)*$/', $version) !== 1) {
			printf("%-32s %-10s not an exact version, update it by hand\n", $label, $version);
			continue;
		}

		if ($tool->release($version) === null) {
			printf("%-32s %-10s not a stable release on Packagist\n", $label, $version);
			$failed = true;
			continue;
		}

		$minor  = $tool->newest($version, $versions, minAge: $options['--min-age'])?->version;
		$latest = $tool->newest($version, $versions, major: true, minAge: $options['--min-age'])?->version;
		$newer  = [];

		if ($minor !== null && Comparator::greaterThan($minor, $version) === true) {
			$newer[] = $minor;
		}

		if ($latest !== null && $latest !== $minor && Comparator::greaterThan($latest, $version) === true) {
			$newer[] = $latest . ' (major)';
		}

		printf("%-32s %-10s %s\n", $label, $version, $newer === [] ? '✓' : '→ ' . implode(', ', $newer));

		$target = $options['--major'] === true ? $latest : $minor;

		if ($target !== null && Comparator::greaterThan($target, $version) === true) {
			$targets[$version] = $target;
		}
	}

	// in the order of the pin, so only the versions change
	if ($targets !== []) {
		$pin     = implode('||', array_map(fn ($version) => $targets[$version] ?? $version, $tool->versions()));
		$updated = str_replace($tool->package . ':' . $tool->pin, $tool->package . ':' . $pin, $updated);
	}
}

echo "\nFor PHP " . implode(', ', $versions) . ', which composer.json allows' . "\n";

if ($options['--update'] === true) {
	if ($updated === $json) {
		echo "Nothing to update\n";
	} else {
		file_put_contents('composer.json', $updated);
		echo "Updated the versions in composer.json\n";
	}
}

exit($failed === true ? 1 : 0);
