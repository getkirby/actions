#!/usr/bin/env php
<?php

use Composer\Semver\Comparator;
use Composer\Semver\Constraint\ConstraintInterface;
use Composer\Semver\Semver;
use Composer\Semver\VersionParser;

// the package's own vendor dir when run through cpx or from a clone,
// the host project's when required as a dependency
foreach ([
	dirname(__DIR__) . '/vendor/autoload.php',
	dirname(__DIR__, 3) . '/autoload.php'
] as $autoloader) {
	if (is_file($autoloader) === true) {
		require_once $autoloader;
		break;
	}
}

const USAGE = <<<'TXT'
	Usage: kirby-actions outdated [--update] [--major] [--min-age <days>]

	Lists the tools that the composer scripts run through cpx and their newer
	releases on Packagist that run on the lowest PHP version of the project.

	  --update          raises each tool to its newest release of the same major
	  --major           with --update, to its newest release, also of a new major
	  --min-age <days>  only releases that are at least this many days old

	TXT;

function fail(string $message): never
{
	fwrite(STDERR, $message . "\n");
	exit(1);
}

$args    = array_slice($argv, 1);
$command = array_shift($args);
$options = ['--update' => false, '--major' => false, '--min-age' => 0];

while (($arg = array_shift($args)) !== null) {
	if ($arg === '--min-age') {
		$days = array_shift($args) ?? '';
		ctype_digit($days) === true || fail('--min-age needs a number of days');
		$options['--min-age'] = (int)$days;
		continue;
	}

	is_bool($options[$arg] ?? null) === true || fail("Unknown option {$arg}\n\n" . USAGE);
	$options[$arg] = true;
}

if ($command !== 'outdated') {
	fail(USAGE);
}

if (is_file('composer.json') === false) {
	fail('There is no composer.json in ' . getcwd());
}

$json     = file_get_contents('composer.json');
$composer = json_decode($json, true, flags: JSON_THROW_ON_ERROR);
$parser   = new VersionParser();

// the tools have to run on the lowest PHP version, as CI analyzes on it,
// and a pin of several versions on the PHP versions above it
$range = $parser->parseConstraints($composer['require']['php'] ?? '*');
preg_match('/^(\d+)\.(\d+)/', $range->getLowerBound()->getVersion(), $lowest);
$lowest = $lowest[0] === '0.0' ? null : $lowest[0];

// every `cpx vendor/name:1.2.3` in the scripts, also `"vendor/name:1.2.3||2.0.1"`
$pins    = [];
$scripts = $composer['scripts'] ?? [];

array_walk_recursive($scripts, function (mixed $script) use (&$pins) {
	preg_match_all('!cpx\s+"?([a-z0-9_.-]+/[a-z0-9_.-]+):([^\s"]+)!i', (string)$script, $matches, PREG_SET_ORDER);

	foreach ($matches as [, $package, $versions]) {
		$pins[$package . ':' . $versions] = [$package, $versions];
	}
});

if ($pins === []) {
	fail('The composer scripts run no tools through cpx with a version, e.g. "cpx vendor/name:1.2.3"');
}

// the releases of a package, from Packagist's minified metadata,
// in which each release only lists what changed from the one before
function releases(string $package): array
{
	static $cache = [];

	if (isset($cache[$package]) === true) {
		return $cache[$package];
	}

	$context = stream_context_create(['http' => ['timeout' => 15, 'user_agent' => 'getkirby/actions']]);
	$data    = @file_get_contents('https://repo.packagist.org/p2/' . strtolower($package) . '.json', false, $context);
	$data !== false || throw new RuntimeException('Packagist has no ' . $package);

	$releases = [];
	$release  = [];

	foreach (json_decode($data, true)['packages'][strtolower($package)] ?? [] as $changes) {
		$release    = array_filter([...$release, ...$changes], fn ($value) => $value !== '__unset');
		$releases[] = $release;
	}

	return $cache[$package] = $releases;
}

// the newest stable release that runs on the given PHP versions and is old enough,
// only within the major of the pinned version if one is given
function newest(VersionParser $parser, array $releases, ConstraintInterface $php, ?string $pinned, int $minAge): ?string
{
	$newest = null;
	$cutoff = time() - $minAge * 86400;

	foreach ($releases as $release) {
		$version = ltrim($release['version'], 'v');

		try {
			if (
				VersionParser::parseStability($version) !== 'stable' ||
				($minAge > 0 && strtotime($release['time'] ?? 'now') > $cutoff) ||
				($pinned !== null && Semver::satisfies($version, '^' . $pinned) === false) ||
				$parser->parseConstraints($release['require']['php'] ?? '*')->matches($php) === false
			) {
				continue;
			}
		} catch (UnexpectedValueException) {
			// old releases with a version or constraint Composer no longer reads
			continue;
		}

		if ($newest === null || Comparator::greaterThan($version, $newest)) {
			$newest = $version;
		}
	}

	return $newest;
}

$updated = $json;
$failed  = false;

foreach ($pins as [$package, $token]) {
	$versions = explode('||', $token);
	$sorted   = $versions;
	$targets  = [];
	usort($sorted, fn ($a, $b) => Comparator::compare($a, '<', $b) ? -1 : 1);

	try {
		$releases = releases($package);
	} catch (RuntimeException $e) {
		printf("%-32s %-10s %s\n", $package, $token, $e->getMessage());
		$failed = true;
		continue;
	}

	foreach ($sorted as $i => $pinned) {
		$label = $i === 0 ? $package : '';

		if (preg_match('/^v?\d+(\.\d+)*$/', $pinned) !== 1) {
			printf("%-32s %-10s not an exact version, update it by hand\n", $label, $pinned);
			continue;
		}

		// the lowest version of a pin for the lowest PHP version, the others for any
		$php = $i === 0 && $lowest !== null ? $parser->parseConstraints('~' . $lowest . '.0') : $range;

		$minor  = newest($parser, $releases, $php, $pinned, $options['--min-age']);
		$latest = newest($parser, $releases, $php, null, $options['--min-age']);
		$newer  = [];

		if ($minor !== null && Comparator::greaterThan($minor, $pinned) === true) {
			$newer[] = $minor;
		}

		if ($latest !== null && $latest !== $minor && Comparator::greaterThan($latest, $pinned) === true) {
			$newer[] = $latest . ' (major)';
		}

		printf("%-32s %-10s %s\n", $label, $pinned, $newer === [] ? '✓' : '→ ' . implode(', ', $newer));

		$target = $options['--major'] === true ? $latest : $minor;

		if ($target !== null && Comparator::greaterThan($target, $pinned) === true) {
			$targets[$pinned] = $target;
		}
	}

	// in the order of the pin, so only the versions change
	if ($targets !== []) {
		$new     = implode('||', array_map(fn ($version) => $targets[$version] ?? $version, $versions));
		$updated = str_replace($package . ':' . $token, $package . ':' . $new, $updated);
	}
}

echo "\n" . ($lowest === null
	? 'composer.json requires no PHP version, so the tools may need a newer one'
	: 'For PHP ' . $lowest . ', the lowest that composer.json allows') . "\n";

if ($options['--update'] === true) {
	if ($updated === $json) {
		echo "Nothing to update\n";
	} else {
		file_put_contents('composer.json', $updated);
		echo "Updated the versions in composer.json\n";
	}
}

exit($failed === true ? 1 : 0);
