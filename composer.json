{
	"name": "getkirby/actions",
	"description": "Reusable workflows and GitHub Actions for the CI of Kirby's core, libraries and plugins",
	"license": "MIT",
	"type": "library",
	"homepage": "https://github.com/getkirby/actions",
	"require": {
		"php": "^8.3",
		"composer/semver": "^3.5.2"
	},
	"autoload": {
		"psr-4": {
			"Kirby\\Actions\\": "lib/"
		}
	},
	"bin": ["bin/kirby-actions"],
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"analyze:composer": [
			"composer validate --strict --no-check-version --no-check-all",
			"cpx icanhazstring/composer-unused:0.9.7 --no-progress"
		],
		"fix": "cpx getkirby/php-cs:0.2.1 fix"
	}
}
